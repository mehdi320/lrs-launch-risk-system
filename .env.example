# LRS™ – Launch Risk System
# Copiez ce fichier en .env et ajoutez votre clé API OpenAI

# Clé API OpenAI (obligatoire)
# Obtenez la vôtre sur : https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── Intégrations (optionnel, plans Pro/Agency) ──────────────────
# Peuvent aussi être définies dans .streamlit/secrets.toml (prioritaire sur .env)

# Notification Slack après chaque audit — créez un webhook sur api.slack.com/apps
SLACK_WEBHOOK_URL=

# Export Google Sheets (service account, API Sheets v4 activée)
GOOGLE_SHEETS_CREDS=
GOOGLE_SHEETS_ID=

# Export Notion (intégration interne avec accès à la base cible)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Webhook générique sortant — reçoit un POST JSON {"event":"audit_completed",...}
# après chaque audit terminé (tous plans, pas uniquement Pro/Agency)
GENERIC_WEBHOOK_URL=
