# LRS™ – Launch Risk System
# Copiez ce fichier en .env et ajoutez votre clé API OpenAI

# Clé API OpenAI (obligatoire)
# Obtenez la vôtre sur : https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── Intégrations (optionnel, plans Pro/Agency) ──────────────────
# Peuvent aussi être définies dans .streamlit/secrets.toml (prioritaire sur .env)

# Notification Slack après chaque audit — créez un webhook sur api.slack.com/apps
SLACK_WEBHOOK_URL=

# Export Google Sheets (service account, API Sheets v4 activée)
GOOGLE_SHEETS_CREDS=
GOOGLE_SHEETS_ID=

# Export Notion (intégration interne avec accès à la base cible)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Webhook générique sortant — reçoit un POST JSON {"event":"audit_completed",...}
# après chaque audit terminé (tous plans, pas uniquement Pro/Agency)
GENERIC_WEBHOOK_URL=

# ── Abonnement Stripe (app.py + webhook_server.py) ──────────────
# Mot de passe partagé bêta (le gate historique, indépendant de Stripe)
APP_PASSWORD=change-moi

# Base SQLite partagée par les deux services — DOIT être le même chemin absolu
# des deux côtés. Attention : une variable vide ("") n'est PAS la même chose
# qu'une variable absente, sqlite3.connect("") ouvre une base temporaire
# différente à chaque appel. Laissez la ligne commentée plutôt que vide si
# vous voulez le défaut (fichier .lrs_users.db à la racine du repo).
# LRS_USERS_DB_PATH=/app/data/.lrs_users.db

# Clé secrète Stripe (sk_test_... en sandbox, sk_live_... en production)
STRIPE_SECRET_KEY=
# ID du prix de l'offre bêta (price_...), créé dans le Dashboard Stripe
STRIPE_PRICE_ID=
# Secret de signature du endpoint webhook (whsec_...), donné par Stripe
# au moment de configurer l'endpoint dans le Dashboard
STRIPE_WEBHOOK_SECRET=
# Plan attribué (clé de PLAN_LIMITS dans app.py) aux acheteurs de cette offre
STRIPE_CHECKOUT_PLAN=starter
# Dev uniquement : accepte les webhooks non signés (payload JSON brut) pour
# tester sans configurer STRIPE_WEBHOOK_SECRET. Ne JAMAIS activer en prod.
LRS_ALLOW_UNVERIFIED_WEBHOOK=false

# URL publique de l'app Streamlit — utilisée pour construire le lien magique
# envoyé par email et les success_url/cancel_url du checkout Stripe
LRS_APP_URL=https://app.votre-domaine.example

# SMTP pour l'envoi du lien magique (mêmes variables que les alertes d'audit)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Déploiement Docker + Caddy (TLS Let's Encrypt automatique) ──
# Domaine de l'app Streamlit et de l'API webhook — DNS pointant vers le VPS
LRS_APP_DOMAIN=app.votre-domaine.example
LRS_API_DOMAIN=api.votre-domaine.example
