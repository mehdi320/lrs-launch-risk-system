# LRS™ – Launch Risk System
# Copiez ce fichier en .env et ajoutez vos clés API

# Clé API OpenAI — moteur de secours pour l'audit LRS (pilote FastAPI) tant
# qu'ANTHROPIC_API_KEY n'est pas configurée ; sinon inutilisée pour l'audit.
# Obtenez la vôtre sur : https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Clé API Anthropic — moteur préféré pour l'audit LRS dans le pilote FastAPI
# (audit_engine.py bascule automatiquement dès que cette clé est présente),
# et obligatoire pour le module Creative Studio (génération de copy et de
# séquences email).
# Obtenez la vôtre sur : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Secret du webhook Stripe (obligatoire en production pour le service de
# diffusion Creative Studio — vérifie l'authenticité des notifications d'achat)
# Obtenez-le sur : https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# Pilote FastAPI (pilot_server.py) — optionnel, protège l'accès par mot de
# passe partagé (sinon accès libre, voir PILOT_UI.md/DEPLOYMENT.md).
# APP_SECRET_KEY : clé de session fixe (recommandé en prod pour survivre aux
#   redémarrages, sinon générée aléatoirement à chaque démarrage).
# APP_HTTPS_ONLY : à mettre à "true" dès que le pilote tourne derrière un
#   reverse proxy qui termine le TLS (sinon le cookie de session n'a pas le
#   flag Secure) — laisser à false/absent en dev local sans TLS.
APP_PASSWORD=
APP_SECRET_KEY=
APP_HTTPS_ONLY=false
