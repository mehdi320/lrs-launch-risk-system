# LRS™ – Launch Risk System
# Copiez ce fichier en .env et ajoutez vos clés API

# Clé API OpenAI — moteur de secours pour l'audit LRS (pilote FastAPI) tant
# qu'ANTHROPIC_API_KEY n'est pas configurée ; sinon inutilisée pour l'audit.
# Obtenez la vôtre sur : https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Clé API Anthropic — moteur préféré pour l'audit LRS dans le pilote FastAPI
# (audit_engine.py bascule automatiquement dès que cette clé est présente),
# et obligatoire pour le module Creative Studio (génération de copy et de
# séquences email).
# Obtenez la vôtre sur : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Secret du webhook Stripe (obligatoire en production pour le service de
# diffusion Creative Studio — vérifie l'authenticité des notifications d'achat)
# Obtenez-le sur : https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# Pilote FastAPI (pilot_server.py) — optionnel, protège l'accès par mot de
# passe partagé (sinon accès libre, voir PILOT_UI.md/DEPLOYMENT.md).
# APP_SECRET_KEY : clé de session fixe (recommandé en prod pour survivre aux
#   redémarrages, sinon générée aléatoirement à chaque démarrage).
# APP_HTTPS_ONLY : à mettre à "true" dès que le pilote tourne derrière un
#   reverse proxy qui termine le TLS (sinon le cookie de session n'a pas le
#   flag Secure) — laisser à false/absent en dev local sans TLS.
APP_PASSWORD=
APP_SECRET_KEY=
APP_HTTPS_ONLY=false

# ── Abonnement LRS (bundle bêta, Stripe) ─────────────────────
# Gate l'accès à app.py par abonnement individuel (voir
# check_subscription_access() dans app.py et le webhook Stripe étendu dans
# creative_studio/serving/app.py). STRIPE_WEBHOOK_SECRET ci-dessus est
# réutilisé tel quel — même endpoint /webhook/stripe, même secret.
#
# STRIPE_BETA_PRICE_ID : l'ID du Price Stripe (price_...) du plan bêta
#   unique (50€/mois), créé une fois dans le Dashboard Stripe.
# LRS_APP_URL : URL publique de l'app Streamlit — utilisée pour construire
#   le lien magique envoyé par email et le success_url de la Session
#   Checkout. Laisser localhost en dev.
# LRS_SALES_PAGE_URL : URL de la page de vente statique — utilisée comme
#   cancel_url (paiement annulé/échoué) et affichée sur l'écran de
#   verrouillage si aucun abonnement actif n'est trouvé. Obligatoire pour
#   que /checkout/beta fonctionne.
# LRS_USERS_DB_PATH : chemin du fichier SQLite users/magic_links (par
#   défaut .lrs_users.db à la racine du repo) — base séparée de
#   .lrs_creative_studio.db, voir user_accounts.py.
STRIPE_BETA_PRICE_ID=price_your-beta-plan-price-id-here
LRS_APP_URL=http://localhost:8501
LRS_SALES_PAGE_URL=
LRS_USERS_DB_PATH=

# ── SMTP (envoi d'emails) ─────────────────────────────────────
# Utilisé par email_alerts.py : rapport d'audit, alertes monitoring,
# digest hebdomadaire, ET le lien magique de connexion (user_accounts.py)
# — sans SMTP configuré, un abonné activé par Stripe ne peut pas recevoir
# son lien d'accès. Testez votre config avec `python3 test_smtp.py
# votre-email@exemple.com` avant de brancher le reste (voir
# STRIPE_SMTP_SETUP.md).
#
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=votre adresse
#   Gmail complète. SMTP_PASSWORD doit être un "mot de passe d'application"
#   (https://myaccount.google.com/apppasswords) — le mot de passe normal du
#   compte ne fonctionne pas si la validation en 2 étapes est activée.
# SendGrid / Mailgun / Resend / Postmark : SMTP_HOST fourni par le
#   service, SMTP_USER/PASSWORD = vos identifiants API SMTP (souvent
#   SMTP_USER="apikey" et SMTP_PASSWORD=<clé API> pour SendGrid). Ports
#   587 (STARTTLS, ce que ce projet utilise) ou 465 (SSL direct, non
#   supporté ici) selon le fournisseur — vérifiez sa doc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
