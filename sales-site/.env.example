# Lien de paiement Stripe (Payment Link) vers lequel pointe le CTA principal
# de la page de vente. À créer dans le Dashboard Stripe (Produit > Payment Links).
NEXT_PUBLIC_STRIPE_LINK=https://buy.stripe.com/xxxxxxxx

# Pixels publicitaires — laissés VIDES par défaut. Tant qu'ils ne sont pas
# renseignés, aucun script de tracking ne se charge (voir app/layout.tsx).
# ⚠️ Dès que vous en remplissez un, ajoutez un bandeau de consentement
# cookies pour les visiteurs UE avant de lancer du trafic dessus.
#
# Meta Pixel : Events Manager Meta → Sources de données → votre pixel →
# Détails de configuration (format numérique, ex. 1234567890123456).
NEXT_PUBLIC_META_PIXEL_ID=

# Google — accepte un ID Google Analytics 4 ("G-XXXXXXX", Admin → Flux de
# données) OU un ID Google Ads ("AW-XXXXXXX", Outils → Suivi des
# conversions) : même script gtag.js pour les deux, un seul ID à la fois.
NEXT_PUBLIC_GTAG_ID=
