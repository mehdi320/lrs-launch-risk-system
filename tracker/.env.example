# ── Meta Marketing API ────────────────────────────────────────────────────────
# Token d'accès longue durée (60 jours) — voir README pour le générer
META_ACCESS_TOKEN=your_long_lived_access_token_here

# ID du compte publicitaire — format : act_XXXXXXXXX
META_AD_ACCOUNT_ID=act_123456789

# Optionnel : nécessaire uniquement si tu veux rafraîchir le token via l'API
META_APP_ID=your_app_id
META_APP_SECRET=your_app_secret

# ── Webhook Systeme.io ────────────────────────────────────────────────────────
# Clé secrète pour valider la signature des webhooks (recommandé)
# Copie-la depuis Systeme.io > Paramètres > Webhooks
WEBHOOK_SECRET=your_webhook_secret_here

# Port du serveur webhook (défaut : 5000)
PORT=5000
